---
import { getTranslation } from '../Locals/index.js';

interface Props {
  lang: string;
}

const { lang = 'es' } = Astro.props;
const t = getTranslation(lang);
const content = t.travelTools;

// Styles
const styles = {
  // Layout
  section: "bg-white py-16 lg:py-[110px]",
  container: "max-w-[1440px] mx-auto px-6 sm:px-10 lg:px-[135px]",

  // Header Row
  headerGrid: "flex flex-col lg:flex-row lg:items-end justify-between gap-6 lg:gap-12 mb-12 lg:mb-[64px]",
  titleBlock: "max-w-[515px]",
  eyebrow: "block font-semibold text-[16px] leading-[28px] tracking-[0.75px] uppercase text-[#BCA4FF] mb-3 lg:mb-[16px]",
  title: "font-bold text-[34px] sm:text-[42px] lg:text-[48px] leading-[1.12] lg:leading-[50px] tracking-[1px] text-[#4E4B66]",
  description: "font-normal text-[16px] leading-[28px] tracking-[0.75px] text-black max-w-[435px]",

  // Cards Grid
  cardsGrid: "grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-[31px]",
  card: "bg-white border border-[#E4DAFF] rounded-[24px] px-6 py-10 lg:pt-[53px] lg:pb-[44px] lg:px-[33px] lg:min-h-[522px] flex flex-col items-center text-center transition-shadow hover:shadow-xl hover:shadow-indigo-500/5",
  
  // Card Content
  imageWrapper: "w-full max-w-[303px] h-[180px] flex items-center justify-center mb-8 lg:mb-[36px]",
  image: "w-full h-full object-contain",
  cardTitle: "font-semibold text-[18px] leading-[28px] tracking-[0.75px] text-black mb-3",
  cardDesc: "font-normal text-[16px] leading-[28px] tracking-[0.75px] text-black max-w-[260px] mb-8",
  
  // Card Button
  cardButton: "mt-auto flex items-center justify-center w-full max-w-[245px] h-[64px] rounded-full border border-[#D9DBE9] bg-white hover:border-[#5F2EEA] hover:bg-indigo-50/40 text-[#5F2EEA] font-semibold text-sm tracking-[0.75px] uppercase transition-all"
};
---

<section class={styles.section}>
  <div class={styles.container}>
    
    <!-- Header Row -->
    <div class={styles.headerGrid}>
      <div class={styles.titleBlock}>
        <span class={styles.eyebrow}>{content.eyebrow}</span>
        <h2 class={styles.title}>{content.title}</h2>
      </div>
      
      <p class={styles.description}>
        {content.description}
      </p>
    </div>

    <!-- Cards Grid -->
    <div class={styles.cardsGrid}>
      {content.items.map((tool: any) => (
        <article class={styles.card}>
          <div class={styles.imageWrapper}>
            <img 
              src={tool.image} 
              alt={tool.imageAlt} 
              class={styles.image}
              loading="lazy"
            />
          </div>
          
          <h3 class={styles.cardTitle}>{tool.title}</h3>
          <p class={styles.cardDesc}>{tool.description}</p>
          
          <a href={`#${tool.id}`} class={styles.cardButton}>
            {content.learnMore}
          </a>
        </article>
      ))}
    </div>

  </div>
</section>