---
import { getTranslation } from "../../Locals/index.js";

interface Props {
  lang?: string;
}

const { lang = "es" } = Astro.props;
const t = getTranslation(lang);

const fallbackAlerts =
  lang === "en"
    ? {
        expandMoreAria: "Show more properties",
        closeAlertAria: "Dismiss notification",
        successLine1: "Lock in a great price for your upcoming stay",
        successLine2:
          "Get instant confirmation with FREE cancellation on most rooms!",
        warningText:
          "From 6 April 2022, your chosen cancellation policy will apply, regardless of Coronavirus. We recommend booking a free cancellation option in case your travel plans need to change.",
      }
    : {
        expandMoreAria: "Ver más alojamientos",
        closeAlertAria: "Cerrar aviso",
        successLine1: "Asegura un gran precio para tu próxima estancia",
        successLine2:
          "¡Obtén confirmación inmediata con cancelación GRATUITA en la mayoría de habitaciones!",
        warningText:
          "A partir del 6 de abril de 2022 se aplicará la política de cancelación elegida. Recomendamos reservar una opción con cancelación gratuita por si cambian tus planes de viaje.",
      };

const content = {
  ...fallbackAlerts,
  ...(t?.plansPage?.alerts ?? {}),
};

// Styles
const styles = {
  // Layout
  section: "bg-white pt-2 pb-12 lg:pt-4 lg:pb-[72px]",
  container: "max-w-[1440px] mx-auto px-6 sm:px-10 lg:px-[125px]",
  innerWrapper: "max-w-[1167px]",

  // Mobile Divider with Down Arrow
  mobileDividerRow: "flex md:hidden items-center gap-5 mb-8",
  dividerLine: "flex-1 h-[1px] bg-[#D9DBE9]",
  downArrowBtn:
    "w-[44px] h-[44px] shrink-0 rounded-full border border-[#5F2EEA] flex items-center justify-center text-[#5F2EEA] hover:bg-[#F3EFFF] transition-colors cursor-pointer",

  // Alerts Stack
  alertsStack: "flex flex-col gap-5 lg:gap-[24px]",

  // Green Success Banner
  successBanner:
    "relative flex items-start md:items-center justify-between gap-4 bg-[#F2FFFB] border-2 border-[#00BA88] rounded-[16px] px-5 py-5 sm:px-[26px] sm:py-[20px] transition-all",
  successText:
    "font-medium text-[14px] leading-[22px] tracking-[0.25px] text-[#00966D] max-w-[462px]",

  // Pink Warning Banner
  warningBanner:
    "relative flex items-start md:items-center justify-between gap-4 bg-[#FFF3F8] border-2 border-[#ED2E7E] rounded-[16px] px-5 py-5 sm:px-[26px] sm:py-[20px] transition-all",
  warningText:
    "font-medium text-[14px] leading-[22px] tracking-[0.25px] text-[#C30052] max-w-[920px]",

  // Shared Left Content & Icon Slot
  bannerContent: "flex items-start md:items-center gap-4 sm:gap-[20px]",
  iconSlot:
    "w-[24px] h-[24px] shrink-0 flex items-center justify-center mt-0.5 md:mt-0",

  // Close Button (X)
  closeBtn:
    "shrink-0 p-1 text-[#14142B] hover:opacity-60 transition-opacity cursor-pointer self-center",
};
---

<section class={styles.section}>
  <div class={styles.container}>
    <div class={styles.innerWrapper}>
      <!-- Mobile Divider + Down Arrow -->
      <div class={styles.mobileDividerRow}>
        <span class={styles.dividerLine}></span>
        <button
          type="button"
          class={styles.downArrowBtn}
          aria-label={content.expandMoreAria}
        >
          <svg
            width="14"
            height="8"
            viewBox="0 0 14 8"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            aria-hidden="true"
          >
            <path
              d="M1 1L7 7L13 1"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </button>
        <span class={styles.dividerLine}></span>
      </div>

      <!-- Alerts Stack -->
      <div class={styles.alertsStack}>
        <!-- Alert 1: Green Success Banner -->
        <div class={styles.successBanner} role="status" data-alert-banner>
          <div class={styles.bannerContent}>
            <!-- ICON SLOT 1 (24x24): Thumbs-up icon -->
            <span class={styles.iconSlot} aria-hidden="true">
              <svg
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  d="M7 11V19C7 19.5523 6.55228 20 6 20H4C3.44772 20 3 19.5523 3 19V12C3 11.4477 3.44772 11 4 11H7ZM7 11L10.3 4.8C10.6 4.2 11.3 3.9 11.9 4.1C12.6 4.3 13 5 13 5.7V9.5H18.4C19.6 9.5 20.5 10.6 20.3 11.8L19.1 18.3C18.9 19.3 18.1 20 17.1 20H7"
                  stroke="#14142B"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </span>

            <p class={styles.successText}>
              {content.successLine1}
              <br class="hidden md:inline" /> {content.successLine2}
            </p>
          </div>

          <button
            type="button"
            class={styles.closeBtn}
            aria-label={content.closeAlertAria}
            data-close-alert
          >
            <svg
              width="10"
              height="10"
              viewBox="0 0 10 10"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
              aria-hidden="true"
            >
              <path
                d="M1 1L9 9M9 1L1 9"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
              />
            </svg>
          </button>
        </div>

        <!-- Alert 2: Pink Warning Banner -->
        <div class={styles.warningBanner} role="alert" data-alert-banner>
          <div class={styles.bannerContent}>
            <!-- ICON SLOT 2 (24x24): Exclamation circle icon -->
            <span class={styles.iconSlot} aria-hidden="true">
              <svg
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
              >
                <circle
                  cx="12"
                  cy="12"
                  r="9"
                  stroke="#14142B"
                  stroke-width="1.8"
                />
                <path
                  d="M12 8V12.5"
                  stroke="#14142B"
                  stroke-width="1.8"
                  stroke-linecap="round"
                />
                <circle cx="12" cy="16" r="1" fill="#14142B" />
              </svg>
            </span>

            <p class={styles.warningText}>{content.warningText}</p>
          </div>

          <button
            type="button"
            class={styles.closeBtn}
            aria-label={content.closeAlertAria}
            data-close-alert
          >
            <svg
              width="10"
              height="10"
              viewBox="0 0 10 10"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
              aria-hidden="true"
            >
              <path
                d="M1 1L9 9M9 1L1 9"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
              />
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll("[data-close-alert]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const banner = btn.closest("[data-alert-banner]");
      if (banner instanceof HTMLElement) {
        banner.style.display = "none";
      }
    });
  });
</script>
