---
import { getTranslation } from "../Locals/index.js";

interface Props {
  lang: string;
}

const { lang = "es" } = Astro.props;
const t = getTranslation(lang);
const content = t.contactSection;

// Styles
const styles = {
  // Layout
  section: "bg-white pb-16 lg:pb-[110px]",
  container: "max-w-[1440px] mx-auto px-6 sm:px-10 lg:px-[135px]",

  // Banner
  banner:
    "relative overflow-hidden w-full max-w-[1169px] min-h-[380px] lg:h-[436px] bg-[#5F2EEA] rounded-[24px] lg:rounded-[32px] px-6 py-12 lg:py-0 flex flex-col items-center justify-center text-center shadow-2xl shadow-indigo-500/10",

  // Geometric overlay matching the diagonal cuts
  geoOverlay1:
    "absolute inset-0 pointer-events-none bg-gradient-to-tr from-transparent via-[#7C4DFF]/10 to-[#B388FF]/20 mix-blend-overlay",
  geoOverlay2:
    "absolute -top-1/4 -right-1/4 w-[80%] h-[150%] bg-white/5 origin-bottom-left rotate-[28deg] pointer-events-none",
  geoOverlay3:
    "absolute -bottom-1/3 -left-1/3 w-[80%] h-[150%] bg-[#4A148C]/20 origin-top-right rotate-[15deg] pointer-events-none",

  // Content
  contentBox: "relative z-10 max-w-[605px] flex flex-col items-center",
  title:
    "font-bold text-[32px] sm:text-[40px] lg:text-[48px] leading-[1.12] lg:leading-[50px] tracking-[1px] text-white mb-8 lg:mb-[32px]",

  // Button
  button:
    "flex items-center justify-center w-full sm:w-[243px] h-[64px] border-2 border-white hover:bg-white hover:text-[#5F2EEA] text-white font-semibold rounded-full transition-all tracking-wider text-sm uppercase cursor-pointer",
};
---

<section class={styles.section}>
  <div class={styles.container}>
    <div class={styles.banner}>
      <!-- Geometric effects -->
      <div class={styles.geoOverlay1} aria-hidden="true"></div>
      <div class={styles.geoOverlay2} aria-hidden="true"></div>
      <div class={styles.geoOverlay3} aria-hidden="true"></div>

      <!-- Content -->
      <div class={styles.contentBox}>
        <h2 class={styles.title}>{content.title}</h2>

        <button type="button" class={styles.button}>
          {content.buttonText}
        </button>
      </div>
    </div>
  </div>
</section>
