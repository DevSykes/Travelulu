---
import { getTranslation } from '../Locals/index.js';

interface Props {
  lang: string;
}

const { lang = 'es' } = Astro.props;
const t = getTranslation(lang);
const content = t.tripPlans;


const styles = {
  section: "relative bg-white pt-6 pb-16 overflow-hidden",
  wrapper: "max-w-[1400px] mx-auto px-6 sm:px-8 lg:px-12",
  
  // Header
  nav: "flex items-center justify-between mb-12 lg:mb-20",
  logo: "text-indigo-700 font-bold text-2xl sm:text-3xl tracking-tight font-['Poppins']",
  menuButton: "w-7 h-7 flex items-center justify-center text-indigo-700 hover:opacity-85 transition-opacity focus:outline-none",
  
  // Hero Content Grid
  heroGrid: "grid grid-cols-1 lg:grid-cols-12 gap-12 items-center mb-20",
  leftColumn: "lg:col-span-6 z-10",
  rightColumn: "lg:col-span-6 relative flex justify-center lg:justify-end",
  
  // Typography
  title: "font-['Poppins'] font-bold text-[40px] sm:text-[54px] lg:text-[64px] leading-[1.05] text-[#2D2A4A] mb-8 tracking-[1px]",
  buttonContainer: "flex flex-col sm:flex-row items-stretch sm:items-center gap-4",
  
  // Buttons
  primaryBtn: "flex items-center justify-center px-8 h-[64px] bg-[#5F2EEA] hover:bg-[#4f23cb] text-white font-semibold rounded-full shadow-lg shadow-indigo-500/25 transition-all tracking-wide text-sm",
  secondaryBtn: "flex items-center justify-center px-8 h-[64px] border-2 border-[#5F2EEA] hover:bg-indigo-50 text-[#5F2EEA] font-semibold rounded-full transition-all tracking-wide text-sm",
  
  // Ilustration
  illustration: "w-full max-w-[650px] lg:max-w-none h-auto object-contain",

  // Stats Bar
  statsGrid: "grid grid-cols-1 md:grid-cols-3 gap-8 pt-12 border-t border-gray-100",
  statItem: "flex flex-col space-y-2",
  statHeader: "flex items-center space-x-3 text-indigo-600",
  statNumber: "font-['Poppins'] font-bold text-3xl sm:text-4xl text-[#2D2A4A]",
  statDesc: "text-gray-500 text-sm leading-relaxed"
};
---

<section class={styles.section}>
  <div class={styles.wrapper}>
    
    <!-- HEADER -->
    <header class={styles.nav}>
      <a href={`/${lang}`} class={styles.logo}>
        {content.logo}
      </a>
      
      <button aria-label={content.navMenuAlt} class={styles.menuButton}>
        <!-- menu icon -->
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-full h-full">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>
      </button>
    </header>

    <!-- HERO SECTION -->
    <div class={styles.heroGrid}>
      
      <!-- left column -->
      <div class={styles.leftColumn}>
        <h1 class={styles.title}>
          {content.title}
        </h1>
        
        <div class={styles.buttonContainer}>
          <a href="#begin" class={styles.primaryBtn}>
            {content.beginPlans}
          </a>
          <a href="#review" class={styles.secondaryBtn}>
            {content.reviewPlans}
          </a>
        </div>
      </div>

      <!-- right column -->
      <div class={styles.rightColumn}>
        <!-- Nota: foto aqui -->
        <img 
          src="/assets/boarding-illustration.svg" 
          alt="Iustración de viaje" 
          class={styles.illustration}
          loading="eager"
        />
      </div>

    </div>

    <!-- STATS SECTION -->
    <div class={styles.statsGrid}>
      
      <!-- Stat 1: Locations -->
      <div class={styles.statItem}>
        <div class={styles.statHeader}>
          <!-- Icono avión pequeño -->
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
          </svg>
          <span class={styles.statNumber}>{content.stats.locations.number}</span>
        </div>
        <p class={styles.statDesc}>{content.stats.locations.description}</p>
      </div>

      <!-- Stat 2: Reviews -->
      <div class={styles.statItem}>
        <div class={styles.statHeader}>
          <!-- Icon reviews -->
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span class={styles.statNumber}>{content.stats.reviews.number}</span>
        </div>
        <p class={styles.statDesc}>{content.stats.reviews.description}</p>
      </div>

      <!-- Stat 3: Travellers -->
      <div class={styles.statItem}>
        <div class={styles.statHeader}>
          <!-- Icon trav -->
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
          </svg>
          <span class={styles.statNumber}>{content.stats.travellers.number}</span>
        </div>
        <p class={styles.statDesc}>{content.stats.travellers.description}</p>
      </div>

    </div>

  </div>
</section>