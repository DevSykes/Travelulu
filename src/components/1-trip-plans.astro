---
import { getTranslation } from "../Locals/index.js";

interface Props {
  lang: string;
}

const { lang = "es" } = Astro.props;
const t = getTranslation(lang);
const content = t.tripPlans;

// Styles
const styles = {
  // Layout
  section: "relative bg-white overflow-x-clip",

  // Hero
  heroWrapper: "relative max-w-[1440px] mx-auto",
  heroContainer:
    "flex flex-col-reverse lg:block lg:h-[634px] px-6 sm:px-10 lg:px-[135px]",
  textColumn:
    "relative z-10 max-w-[669px] pt-6 pb-12 lg:h-full lg:flex lg:flex-col lg:justify-end lg:pt-0 lg:pb-[216px]",
  title:
    "font-bold text-[40px] sm:text-[54px] lg:text-[56px] xl:text-[64px] leading-[1.12] xl:leading-[66px] text-[#4E4B66] tracking-[1px] mb-8 lg:mb-[32px]",

  // Buttons
  buttonContainer:
    "flex flex-col sm:flex-row items-stretch sm:items-center gap-4 lg:gap-[25px]",
  primaryBtn:
    "flex items-center justify-center w-full sm:w-[243px] h-[64px] bg-[#5F2EEA] hover:bg-[#4f23cb] text-white font-semibold rounded-full shadow-lg shadow-indigo-500/20 transition-all tracking-wider text-sm uppercase",
  secondaryBtn:
    "flex items-center justify-center w-full sm:w-[243px] h-[64px] bg-white border-2 border-[#5F2EEA] hover:bg-indigo-50 text-[#5F2EEA] font-semibold rounded-full transition-all tracking-wider text-sm uppercase",

  // Illustration
  illustrationWrapper:
    "relative pt-6 lg:pt-0 lg:absolute lg:bottom-0 lg:left-[360px] xl:left-[430px] lg:right-[calc(50%-50vw)] lg:w-auto lg:h-[634px] z-20 pointer-events-none select-none",
  illustration:
    "w-full h-auto lg:w-full lg:h-full object-contain lg:object-cover object-left-bottom",

  // Stats
  statsWrapper:
    "relative z-30 px-6 sm:px-10 lg:px-0 lg:border-t lg:border-b lg:border-[#D9DBE9] bg-white",
  statsGrid:
    "max-w-[1440px] mx-auto lg:px-[135px] border border-[#D9DBE9] lg:border-0 grid grid-cols-1 md:grid-cols-3 divide-y md:divide-y-0 md:divide-x divide-[#D9DBE9]",
  statItem:
    "p-8 md:py-10 md:px-8 first:md:pl-0 last:md:pr-0 flex items-start gap-4",
  statIcon: "shrink-0",
  statImg: "w-[37.04px] h-[37.04px] object-contain",
  statContent: "flex flex-col space-y-2",
  statNumber:
    "font-bold text-[28px] lg:text-[32px] leading-none text-[#2A00A2]",
  statDesc: "text-[#6E7191] text-sm leading-relaxed max-w-[230px]",
};
---

<section class={styles.section}>
  <!-- Hero -->
  <div class={styles.heroWrapper}>
    <div class={styles.heroContainer}>
      <!-- Title & Buttons -->
      <div class={styles.textColumn}>
        <h1 class={styles.title}>{content.title}</h1>

        <div class={styles.buttonContainer}>
          <a href={`/${lang}/plans`} class={styles.primaryBtn}>
            {content.beginPlans}
          </a>
          <a href={`/${lang}/plans`} class={styles.secondaryBtn}>
            {content.reviewPlans}
          </a>
        </div>
      </div>

      <!-- Illustration -->
      <div class={styles.illustrationWrapper}>
        <img
          src="/Boarding.avif"
          alt={content.illustrationAlt}
          class={styles.illustration}
          loading="eager"
        />
      </div>
    </div>
  </div>

  <!-- Stats -->
  <div class={styles.statsWrapper}>
    <div class={styles.statsGrid}>
      <!-- Stat 1 -->
      <div class={styles.statItem}>
        <div class={styles.statIcon}>
          <img
            src="/AirplaneTilt.avif"
            alt={content.stats.locations.iconAlt}
            class={styles.statImg}
          />
        </div>
        <div class={styles.statContent}>
          <span class={styles.statNumber}>
            {content.stats.locations.number}
          </span>
          <p class={styles.statDesc}>{content.stats.locations.description}</p>
        </div>
      </div>

      <!-- Stat 2 -->
      <div class={styles.statItem}>
        <div class={styles.statIcon}>
          <img
            src="/GlobeHemisphereEast.avif"
            alt={content.stats.reviews.iconAlt}
            class={styles.statImg}
          />
        </div>
        <div class={styles.statContent}>
          <span class={styles.statNumber}>{content.stats.reviews.number}</span>
          <p class={styles.statDesc}>{content.stats.reviews.description}</p>
        </div>
      </div>

      <!-- Stat 3 -->
      <div class={styles.statItem}>
        <div class={styles.statIcon}>
          <img
            src="/Bicycle.avif"
            alt={content.stats.travellers.iconAlt}
            class={styles.statImg}
          />
        </div>
        <div class={styles.statContent}>
          <span class={styles.statNumber}>
            {content.stats.travellers.number}
          </span>
          <p class={styles.statDesc}>{content.stats.travellers.description}</p>
        </div>
      </div>
    </div>
  </div>
</section>
